{
  "name": "ASN1 Editor (Go + Wails v2)",
  "build": { "dockerfile": "Dockerfile" },
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "bradlc.vscode-tailwindcss",
        "ms-vscode.makefile-tools"
      ]
    }
  },
  "postCreateCommand": "go version && node --version && (wails version || go install github.com/wailsapp/wails/v2/cmd/wails@latest)",
  "mounts": [
    "source=${localWorkspaceFolderBasename}-gocache,target=/go/pkg,type=volume"
  ]
}
